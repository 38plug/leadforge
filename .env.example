# ==========================================================================
# LeadForge — environment configuration
#
# Copy this file to apps/api/.env for the backend and apps/web/.env.local
# for the frontend, then fill in real values. Every external integration
# is optional: leaving a *_API_KEY unset makes the app fall back to a
# mock provider so it always runs locally. Never commit real secrets.
# ==========================================================================

# ---- Backend (apps/api/.env) --------------------------------------------

APP_NAME=LeadForge API
ENVIRONMENT=development
DEBUG=true

# Defaults to a local SQLite file with zero setup. Point this at managed
# Postgres in staging/production:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/leadforge
DATABASE_URL=sqlite:///./leadforge.db

REDIS_URL=redis://localhost:6379/0

# Auth: self-contained JWT auth (register/login/me under /api/auth) is the
# real, working auth path — no external provider required. JWT_SECRET MUST
# be set to a long random value in staging/production (e.g. `openssl rand
# -hex 32`); every issued session token is only as safe as this secret.
JWT_SECRET=change-me-in-production

# Supabase/OIDC fields are reserved for swapping in a managed auth provider
# later (see docs/development.md) — unused today.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Business / location data provider (Lead Finder discovery).
# Defaults to "osm" — OpenStreetMap (Nominatim + Overpass API): completely
# free, no signup, no API key, real business data. No ratings/reviews
# though (OSM doesn't track them). "mock" returns fabricated businesses and
# is refused outright when ENVIRONMENT=production.
BUSINESS_PROVIDER=osm
# Optional: your email or site URL, included in requests to OpenStreetMap's
# Nominatim service per its usage policy. Not required for light use.
OSM_CONTACT=

# Social profiles are read from each business's own public OpenStreetMap
# contact:instagram / contact:facebook tags — there is no separate provider
# and no handle guessing.

# AI provider. "auto" uses real Anthropic models when a key is set below,
# and a deterministic rule-based fallback when it isn't.
AI_PROVIDER=auto
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_MODEL=claude-sonnet-5

# Outreach email. "auto" sends over SMTP once the three SMTP_* values are
# filled in, and otherwise records outreach without sending it. Any mail
# host works, including a free Gmail app password.
EMAIL_PROVIDER=auto
EMAIL_FROM_ADDRESS=outreach@leadforge.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

CORS_ORIGINS=["http://localhost:3000"]

# Billing (Stripe or similar) — wired up in a later phase
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Frontend (apps/web/.env.local) --------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000
