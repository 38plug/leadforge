DATABASE_URL=sqlite:///./leadforge.db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# --- Business discovery (already real, already free) ---------------------
# OpenStreetMap: real businesses in every country, no API key, no billing.
BUSINESS_PROVIDER=osm
# Optional. An email or project URL sent in the User-Agent to OpenStreetMap,
# per their usage policy. Recommended if you run many searches.
OSM_CONTACT=

# --- AI (optional) --------------------------------------------------------
# Providers with a free tier:
#   groq    — https://console.groq.com/keys      (no card required)
#   gemini  — https://aistudio.google.com/apikey (no card required)
# Paid: anthropic, openai, openrouter. Or openai_compatible + a base URL.
# "rules" (or leaving the key blank) uses the deterministic fallback, which
# never invents facts — it only restates that lead's stored attributes.
AI_PROVIDER=groq
AI_PROVIDER_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Only needed for AI_PROVIDER=openai_compatible.
AI_PROVIDER_BASE_URL=

# --- Email sending (optional) --------------------------------------------
# "auto" sends over SMTP once the three SMTP_* values below are filled in,
# and otherwise records outreach without sending it. Any mail host works,
# including a free Gmail account with an app password.
EMAIL_PROVIDER=auto
EMAIL_FROM_ADDRESS=outreach@leadforge.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
